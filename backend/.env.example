# Copy to .env locally; never commit a real token.
NURVO_DATABASE_PATH=./data/nurvo.sqlite3
NURVO_CORS_ORIGINS=https://sandylazo1.github.io,http://127.0.0.1:5500,http://localhost:5173
# Provider disabled until you have a legitimate integration / license.
NURVO_PROVIDER_KIND=disabled
# When a legitimate AutoRiesgo contract and API key exist:
# NURVO_PROVIDER_KIND=autoriesgo
# NURVO_PROVIDER_TOKEN=YOUR_PRIVATE_API_KEY
# NURVO_PROVIDER_AUTHORIZED=true
# NURVO_AUTORIESGO_FETCH_THEFT=false
# NURVO_AUTORIESGO_FETCH_FINES=false
NURVO_PROVIDER_URL=
NURVO_PROVIDER_TOKEN=
NURVO_PROVIDER_NAME=Proveedor autorizado
NURVO_PROVIDER_AUTHORIZED=false
# Only set true if the provider actually has the right to return these verified fields.
NURVO_VERIFIED_THEFT_SOURCE=false
NURVO_VERIFIED_FINES_SOURCE=false
# Optional DOM adapter, only for permitted sources without CAPTCHA/login bypass:
NURVO_ALLOW_PLAYWRIGHT=false
NURVO_PLATE_INPUT_SELECTOR=
NURVO_PLATE_SUBMIT_SELECTOR=
NURVO_PLATE_RESULTS_SELECTOR=
NURVO_THEFT_RESULTS_SELECTOR=
NURVO_MAKE_SELECTOR=
NURVO_MODEL_SELECTOR=
NURVO_YEAR_SELECTOR=
# Requires an always-on backend, a persistent database and a single worker.
NURVO_ENABLE_DAILY_REFRESH=false
NURVO_REFRESH_DELAY_SECONDS=5
NURVO_ENABLE_DOCS=true
# Marketplace B2B is disabled unless a signed partner arrangement and secured host exist.
NURVO_MARKETPLACE_ENABLED=false
# JSON object: {"<64-character SHA256 of random private key>":{"tenant_id":"partner-a","role":"supplier"}}
# Roles: admin, supplier, buyer, workshop, fleet. NO sample real token in repo.
NURVO_MARKETPLACE_KEYS_JSON=
